<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VaruShopRetailer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.VaruShopRetailer" parent="Base.Theme.VaruShopRetailer" />
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/your_primary_brand_color</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>

        <item name="postSplashScreenTheme">@style/Theme.VaruShop</item>
    </style>

    <style name="Theme.VaruShop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/your_primary_brand_color</item>
        <item name="colorPrimaryVariant">#331ABF</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/your_primary_brand_color</item>
    </style>

    <style name="RoundedCorners8">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="RoundedCorners12">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SettingCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOnSurface</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

        <style name="PinDotStyle">
            <item name="android:layout_width">16dp</item>
            <item name="android:layout_height">16dp</item>
            <item name="android:layout_margin">10dp</item>
            <item name="android:background">@drawable/bg_pin_dot_inactive</item>
        </style>

        <style name="KeypadButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
            <item name="android:layout_width">80dp</item>
            <item name="android:layout_height">80dp</item>
            <item name="android:textSize">26sp</item>
            <item name="android:textColor">?attr/colorOnSurface</item>
            <item name="android:insetTop">0dp</item>
            <item name="android:insetBottom">0dp</item>
            <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MaterialComponents.SmallComponent</item>
            <item name="rippleColor">?attr/colorControlHighlight</item>
        </style>

</resources>